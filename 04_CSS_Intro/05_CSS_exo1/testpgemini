                <p>
                    Dans le cadre de mon alternance chez <span class="highlight">Vyv 3</span>, j'ai été missionné pour gérer la transition et la modernisation des équipements de communication de l'établissement.
                </p>
            </section>

            <section class="terminal-box">
                <h3>> ./MISSIONS_REALISEES.log</h3>
                <ul>
                    <li>Audit de l'ancien parc et recensement précis des besoins des utilisateurs.</li>
                    <li>Configuration matérielle et préparation des nouveaux terminaux téléphoniques.</li>
                    <li>Déploiement sur site, brassage réseau et accompagnement des équipes à la prise en main.</li>
                    <li>Mise à jour rigoureuse de l'inventaire matériel et gestion des attributions.</li>
                </ul>
            </section>

            <div class="btn-return-container">
                <button class="matrix-btn" onclick="switchTab('tab-home')">< RETOUR_SYSTEME</button>
            </div>
        </div>

        <!-- ONGLET 3 : COMPÉTENCES (Vide pour le moment) -->
        <div id="tab-skills" class="tab-content">
            <header>
                <h1>> Competences.bat<span class="cursor"></span></h1>
                <h2>Matrice d'aptitudes techniques et transverses</h2>
            </header>

            <div class="lightsaber saber-blue"></div>

            <section class="terminal-box">
                <h3>> ./EN_ATTENTE_DE_DONNEES...</h3>
                <p>Espace réservé pour la liste des compétences.</p>
            </section>

            <div class="btn-return-container">
                <button class="matrix-btn" onclick="switchTab('tab-home')">< RETOUR_SYSTEME</button>
            </div>
        </div>

        <!-- ONGLET 4 : EXPÉRIENCES (Vide pour le moment) -->
        <div id="tab-experiences" class="tab-content">
            <header>
                <h1>> Experiences.log<span class="cursor"></span></h1>
                <h2>Historique professionnel</h2>
            </header>

            <div class="lightsaber saber-red"></div>

            <section class="terminal-box">
                <h3>> ./EN_ATTENTE_DE_DONNEES...</h3>
                <p>Espace réservé pour l'historique des expériences.</p>
            </section>

            <div class="btn-return-container">
                <button class="matrix-btn" onclick="switchTab('tab-home')">< RETOUR_SYSTEME</button>
            </div>
        </div>

    </div>

    <!-- SCRIPTS (Matrice + Gestion des onglets) -->
    <script>
        // --- 1. GESTION DES ONGLETS ---
        function switchTab(targetTabId) {
            const tabs = document.querySelectorAll('.tab-content');
            tabs.forEach(tab => {
                tab.classList.remove('active');
            });

            const targetTab = document.getElementById(targetTabId);
            if (targetTab) {
                targetTab.classList.add('active');
            }
        }

        // --- 2. GENERATEUR DE MATRICE AVEC DEGRADE VERT/BLEU ---
        const canvas = document.getElementById('matrixCanvas');
        const ctx = canvas.getContext('2d');
        let gradient;

        function initCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            
            // Création du dégradé (Vert en haut à gauche vers Bleu en bas à droite)
            gradient = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
            gradient.addColorStop(0, '#00ff41'); // Vert classique Matrix
            gradient.addColorStop(1, '#0077ff'); // Bleu sabre laser Jedi
        }

        initCanvas();

        const matrixChars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*()ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ';
        const charsArray = matrixChars.split('');
        const fontSize = 16;
        let columns = canvas.width / fontSize;
        let drops = [];

        // Initialisation des gouttes
        function initDrops() {
            columns = canvas.width / fontSize;
            drops = [];
            for (let x = 0; x < columns; x++) {
                drops[x] = 1;
            }
        }
        
        initDrops();

        function drawMatrix() {
            // Un fond noir très transparent pour l'effet de traînée
            ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // On applique notre dégradé au texte
            ctx.fillStyle = gradient; 
            ctx.font = fontSize + 'px monospace';

            for (let i = 0; i < drops.length; i++) {
                const text = charsArray[Math.floor(Math.random() * charsArray.length)];
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);

                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                    drops[i] = 0;
                }
                drops[i]++;
            }
        }

        setInterval(drawMatrix, 35);

        // Recalculer la taille du canvas, le dégradé et les gouttes en cas de redimensionnement
        window.addEventListener('resize', () => {
            initCanvas();
            initDrops();
        });
    </script>
</body>
</html>